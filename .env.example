# Server
PORT=5001
NODE_ENV=development
SESSION_SECRET=change-this-to-random-string

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# NicePay (법무법인 윈스)
# 일반결제 (호스팅 결제창) — 착수금
NICEPAY_MERCHANT_ID=winslaw00m
NICEPAY_MERCHANT_KEY=
NICEPAY_CANCEL_PASSWORD=
# 자동결제 (keyin/빌링키) — 성공보수
NICEPAY_KEYIN_MID=winslaw01m
NICEPAY_KEYIN_KEY=

# Email 발송 — 둘 중 하나. M365가 설정되면 M365 우선, 아니면 SMTP(SES).
# (1) M365 (Microsoft Graph, winslaw.co.kr 테넌트 메일함에서 발송) — 권장
#  ⚠ Azure AD 앱에 Mail.Send(애플리케이션) 권한 + 관리자 동의 필요(없으면 403). 4개 모두 있어야 활성.
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_MAIL_SENDER=info@winslaw.co.kr
# (2) SMTP (SES) — M365 미사용 시
SMTP_HOST=email-smtp.ap-northeast-2.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=notice@day.lawyer
# 새 사건 요청(제보) 접수 시 알림 받을 관리자 연락처 (실제 값은 운영 .env 에만 설정)
ADMIN_ALERT_EMAIL=
ADMIN_ALERT_PHONE=

# PII 암호화 키 (AES-256-GCM, 64자 hex = 32바이트)
ENCRYPTION_KEY=

# File Upload
UPLOAD_DIR=./public/uploads
MAX_FILE_SIZE=52428800

# External Services (통합)
DOCUREPEAT_URL=https://docurepeat.com
SIGA_LOOKUP_URL=https://gongsi.estate
CASESCRAPER_URL=https://day.lawyer/casecrab
DAYLAWYER_URL=https://day.lawyer
WILLSAVE_URL=https://willsave.co.kr

# CORS
CORS_ORIGIN=https://class.lawciety.com

# 공개 절대 URL (OG 공유 카드/결제·진행 링크 기준; 미설정시 CORS_ORIGIN 사용)
PUBLIC_BASE_URL=https://class.lawciety.com

# 카카오 공유 (브라우저 JS 키 — 노출 무방, 빌드시 인라인. 미설정시 카카오 버튼 숨김)
VITE_KAKAO_JS_KEY=

# 간편인증(소셜 로그인) — 제공자별 자격증명이 있어야 해당 버튼 노출·동작.
# ⚠ 각 개발자 콘솔에서 Redirect URI 등록 필수: https://class.lawciety.com/api/auth/<provider>/callback
KAKAO_CLIENT_ID=          # 카카오 REST API 키 (callback: /api/auth/kakao/callback)
KAKAO_CLIENT_SECRET=      # 카카오 보안(Client Secret) — 사용 설정 시
NAVER_CLIENT_ID=          # (callback: /api/auth/naver/callback)
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=         # (callback: /api/auth/google/callback)
GOOGLE_CLIENT_SECRET=

# 알림 발송 (알리고 SMS + 카카오 알림톡)
# ⚠ 배포 서버 송신 IP를 알리고 콘솔 화이트리스트에 등록해야 함(미등록 시 -101)
ALIGO_API_KEY=
ALIGO_USER_ID=
ALIGO_SENDER=                 # 사전 등록된 발신번호
# 카카오 알림톡 (Stage B — 발신프로필 + 사전심사 템플릿 확보 후)
ALIGO_KAKAO_SENDER_KEY=
ALIGO_KAKAO_TPL_FILING=
ALIGO_KAKAO_TPL_PAYLINK=
# 알림 동작
NOTIFY_DRY_RUN=1             # 1=실제 발송 차단(콘솔만). 운영 배포 시 0
NOTIFY_FILING_AUTO=1         # filing(소제기) 경과 등록 시 기본 자동발송
